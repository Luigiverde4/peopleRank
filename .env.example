# Copy to .env.local and fill in. Without these values the app runs in offline demo mode (localStorage).
# Local Supabase: run `npx supabase status` and copy "API URL" and "Publishable key".
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public key (sb_publishable_...). In older projects it is called "anon key".
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: force the offline demo even if Supabase is configured.
# VITE_DATA_MODE=memory
